# Google Apps Script Web App Deployment URL
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Secret Token shared between Next.js and Google Apps Script
APPS_SCRIPT_SECRET=your_apps_script_secret_token_here

# JWT Secret for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Base URL (for local development or production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob Storage (diperlukan di production untuk upload foto warta)
# Dapatkan token ini dari: Vercel Dashboard > Project > Storage > Create Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE
